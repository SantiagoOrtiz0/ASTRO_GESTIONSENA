---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Panel Aprendiz">
  <div class="panel-container">
    <h2>Panel del Aprendiz</h2>

    <!-- Sección de datos personales -->
    <div class="info-box">
      <h3>Datos Personales</h3>
      <p><strong>Nombre:</strong> [Aquí irá el nombre]</p>
      <p><strong>Apellido:</strong> [Aquí irá el apellido]</p>
      <p><strong>Ficha:</strong> [Número de ficha]</p>
    </div>

    <!-- Sección de horario -->
    <div class="info-box">
      <h3>Mi Horario</h3>
      <table>
        <thead>
          <tr>
            <th>Día</th>
            <th>Hora Inicio</th>
            <th>Hora Fin</th>
            <th>Materia</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Lunes</td>
            <td>8:00</td>
            <td>12:00</td>
            <td>Programación</td>
          </tr>
          <!-- Más filas aquí -->
        </tbody>
      </table>
    </div>
  </div>

  <style>
    .panel-container {
      max-width: 900px;
      margin: 3rem auto;
      padding: 2rem;
      border: 1px solid #ccc;
      border-radius: 8px;
      background-color: #f9f9f9;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    h2 {
      text-align: center;
      margin-bottom: 2rem;
    }

    .info-box {
      margin-bottom: 2rem;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      border: 1px solid #ccc;
      padding: 0.6rem;
      text-align: center;
    }

    th {
      background-color: #eee;
    }
  </style>
</Layout>
