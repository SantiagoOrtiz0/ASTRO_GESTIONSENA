---
import Layout from "../../layouts/Layout.astro";
import AgGridComponent from "../../components/AgGrid.astro";
import { obtenerToken, decodificarToken, cerrarSesion } from "../../services/authService";

const idAprendiz = Number(Astro.url.searchParams.get("id"));

const CargarAprendiz = async () => {
  try{
    const respuesta = await fetch("http://127.0.0.1:8001/Aprendiz");
    if (!respuesta.ok) {
      throw new Error(`Error HTTP: ${respuesta.status}`);
    }
      const ObjLista = await respuesta.json();
      const Lista = ObjLista.data ?? [];
      return Lista.find((a: any) => a.idAprendiz === idAprendiz);
    } catch (error) {
      console.error("Error al cargar aprendiz:", error);
      return null;
    }
  };

  const CargarAsistencias = async () => {
    try{
      const respuesta = await fetch("http://127.0.0.1:8001/asistencia");

      if (!respuesta.ok) {
        throw new Error(`Error HTTP: ${respuesta.status}`);
      }

      const ObjListaAsistencias = await respuesta.json();
      const ListaAsistencias = ObjListaAsistencias.data ?? [];
      return ListaAsistencias.filter((a:any) => a.idAprendiz === idAprendiz);
 
    }catch (error){
      console.error("Error al cargar asistencias:", error);
      return [];
    }
  };

  const CargarHorarios = async () => {
    try{
      const respuesta = await fetch("http://127.0.0.1:8001/horario");

      if (!respuesta.ok){
        throw new Error (`Error HTTP: ${respuesta.status}`);
      }
      const ObjListaHorario = await respuesta.json();
      return ObjListaHorario.data ?? [];
    } catch (error) {
      console.error("Error al cargar horario:", error);
      return [];
    }
  };

  const aprendiz = await CargarAprendiz();
  const ListaAsistencias = await CargarAsistencias();
  const CabeceraAsistencias = ["Fecha", "Estado"];

  const ListaHorarios = await CargarHorarios();
  const CabeceraHorarios = ["Dia","HoraInicio","HoraFin"];

---

<script lang="ts">
  import { obtenerToken, decodificarToken, cerrarSesion } from "../../services/authService";

  document.addEventListener("DOMContentLoaded", () => {
    const token = obtenerToken();
    if (!token) {
      window.location.href = "/";
    } else {
      const payload = decodificarToken(token);
      if (payload.tipo !== "aprendiz") {
        cerrarSesion();
        window.location.href = "/";
      }
    }
  });
</script>