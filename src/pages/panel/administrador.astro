---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import AgGridAdmin from "../../components/AgGridAdmin.astro";


const idUsuario = Number(Astro.url.searchParams.get("id"));

const CargarUsuarios = async () => {
    try{
        const respuesta = await fetch("http://127.0.0.1:8001/usuario");
        if(!respuesta.ok) {
        throw new Error(`Error HTTP: ${respuesta.status}`);
        }
        const ObjLista = await respuesta.json();
        return ObjLista.data ?? [];
    } catch (error){
        console.error("Error al cargar usuarios:", error);
        return [];
    }
};

const CargarAprendices = async () => {
    try{
        const respuesta = await fetch("http://127.0.0.1:8001/Aprendiz");
        if(!respuesta.ok){
            throw new Error(`Error HTTP: ${respuesta.status}`);
        }
        const ObjAprendiz = await respuesta.json();
        return ObjAprendiz.data ?? [];
    } catch (error){
        console.error("Error al cargar aprendices:", error);
        return [];
    }
 };


 const CargarProgramas = async () => {
    try{
        const respuesta = await fetch("http://127.0.0.1:8001/programa");
        if(!respuesta.ok){
            throw new Error(`Error HTTP: ${respuesta.status}`);
        }
        const ObjPrograma = await respuesta.json();
        return ObjPrograma.data ?? [];
    } catch (error){
        console.error("Error al cargar programa:", error);
    }
 };


 const CargarHorarios = async () => {
    try{
        const respuesta = await fetch("http://127.0.0.1:8001/horario");
        if(!respuesta.ok){
            throw new Error(`Error HTTP: ${respuesta.status}`);
        }
        const ObjHorario = await respuesta.json();
        return ObjHorario.data ?? [];
    }catch (error){
        console.error("Error al cargar horario:", error);
        
    }
 };

    const ListaUsuarios = await CargarUsuarios();
    const CabeceraUsuarios = ["idUsuario","nombres","apellidos", "contrasena", "idRol"];

    const ListaAprendices = await CargarAprendices();
    const CabeceraAprendices = ["idAprendiz","Nombres","Apellidos", "contrasena", "idFicha"];

    const ListaProgramas = await CargarProgramas();
    const CabeceraProgramas = ["idPrograma","nombrePrograma"];

    const ListaHorarios = await CargarHorarios();
    const CabeceraHorarios = ["idHorario","Dia","HoraInicio","HoraFin"];
---
<!-- NAVBAR ADMIN -->
 
 <Layout title="Panel-Administrador">
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1">
                <i class="bi bi-shield-lock-fill me-2"></i>Panel Administrador
            </span>
        </div>
    </nav>

<!-- DISEÑO USUARIO -->

    <div class="container pb-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span><i class="bi bi-people-fill me-2"></i>Usuarios</span>
            </div>
            <div class="card-body">
                <AgGridAdmin data={ListaUsuarios} headers={CabeceraUsuarios} endpoint="http://127.0.0.1:8001/usuario" idField="idUsuario"></AgGridAdmin>
            </div>
        </div>

 <!-- DISEÑO APRENDICES -->
     <div class="card shadow-sm mb-4">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-mortarboard-fill me-2"></i>Aprendices</span>
      </div>
      <div class="card-body">
        <AgGridAdmin data={ListaAprendices} headers={CabeceraAprendices} endpoint="http://127.0.0.1:8001/Aprendiz" idField="idAprendiz"></AgGridAdmin>
      </div>
    </div>

<!-- DISEÑO PROGRAMAS -->
        <div class="card shadow-sm mb-4">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-journal-bookmark-fill me-2"></i>Programas</span>
      </div>
      <div class="card-body">
        <AgGridAdmin data={ListaProgramas} headers={CabeceraProgramas} endpoint="http://127.0.0.1:8001/programa" idField="idPrograma"></AgGridAdmin>
      </div>
    </div>
    <!-- DISEÑO HORARIOS -->
<div class="card shadow-sm mb-4">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <span><i class="bi bi-clock-fill me-2"></i>Horarios</span>
  </div>
  <div class="card-body">
    <AgGridAdmin data={ListaHorarios} headers={CabeceraHorarios} endpoint="http://127.0.0.1:8001/horario" idField="idHorario"></AgGridAdmin>
  </div>
</div>
    </div>
 </Layout>

 <script>
    import { obtenerToken, decodificarToken, cerrarSesion } from "../../services/authService";

    document.addEventListener("DOMContentLoaded", () => {
      const token = obtenerToken();
      if (!token) {
        window.location.href = "/";
      } else {
        const payload = decodificarToken(token);
        if (payload.tipo !== "usuario") {
          cerrarSesion();
          window.location.href = "/";
        }
      }
    });
  </script>