---
import Layout from "../layouts/Layout.astro";
import InputField from "../components/InputField.astro";
import Button from "../components/Button.astro";
---
<Layout title="Login">
  <div class="login-container">
    <h2>Iniciar sesión</h2>

    <div id="errorMsg" style="color:#c0392b; display:none; margin-bottom:1rem;"></div>

    <form id="loginForm">
      <InputField id="nombres" type="text" placeholder="Nombres" required />
      <InputField id="apellidos" type="text" placeholder="Apellidos" required />
      <InputField id="contrasena" type="password" placeholder="Contraseña" required />
      <Button label="Entrar" type="submit" />
    </form>
  </div>

  <style>
    .login-container {
      max-width: 400px;
      margin: 5rem auto;
      padding: 2rem;
      border: 1px solid #ccc;
      border-radius: 8px;
      background-color: #f9f9f9;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      text-align: center;
    }
    .btn-secondary {
      display: inline-block;
      padding: 0.6rem 1.2rem;
      border-radius: 4px;
      background-color: #eee;
      color: #333;
      text-decoration: none;
      margin-top: 0.5rem;
    }
    .registro-link { margin-top: 1rem; }
  </style>

  <script>
  import { login, guardarSesion } from "../services/authService";

  const form = document.getElementById("loginForm") as HTMLFormElement;
  const errorMsg = document.getElementById("errorMsg") as HTMLElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorMsg.style.display = "none";

    const nombres = document.getElementById("nombres") as HTMLInputElement;
    const apellidos = document.getElementById("apellidos") as HTMLInputElement;
    const contrasena = document.getElementById("contrasena") as HTMLInputElement;

    const data = await login(nombres.value, apellidos.value, contrasena.value);

    if (data.token) {
      guardarSesion(data.token, data.tipo, data.panel);
      window.location.href = `/panel/${data.panel}`;
    } else {
      errorMsg.textContent = data.mensaje || "Error al iniciar sesión";
      errorMsg.style.display = "block";
    }
  });
</script>
</Layout>