---
import Layout from "../layouts/Layout.astro";
import InputField from "../components/InputField.astro";
import Button from "../components/Button.astro";

let mensaje = "";
---

<Layout title="Login">
  <div class="login-container">
    <h2>Iniciar sesión</h2>
    <form>
      <InputField id="nombres" type="text" placeholder="Nombres" required />
      <InputField id="apellidos" type="text" placeholder="Apellidos" required />
      <InputField id="contrasena" type="password" placeholder="Contraseña" required />

      <!-- Botón directo al panel del aprendiz -->
      <a href="/panel/aprendiz" class="btn-primary">Entrar</a>
    </form>

    <!-- Enlace hacia Registro -->
    <div class="registro-link">
      <p>¿No tienes cuenta?</p>
      <a href="/Registro" class="btn-secondary">Registrarse</a>
    </div>

    <p>{mensaje}</p>
  </div>

  <style>
    .login-container {
      max-width: 400px;
      margin: 5rem auto;
      padding: 2rem;
      border: 1px solid #ccc;
      border-radius: 8px;
      background-color: #f9f9f9;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      text-align: center;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .btn-primary, .btn-secondary {
      display: inline-block;
      padding: 0.6rem 1.2rem;
      border-radius: 4px;
      text-decoration: none;
      font-weight: 500;
      text-align: center;
      transition: background-color 0.2s ease;
    }

    .btn-primary {
      background-color: #0077cc;
      color: #fff;
    }
    .btn-primary:hover {
      background-color: #005fa3;
    }

    .btn-secondary {
      background-color: #eee;
      color: #333;
    }
    .btn-secondary:hover {
      background-color: #ddd;
    }

    .registro-link {
      margin-top: 1rem;
    }
  </style>
</Layout>
