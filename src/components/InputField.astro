---
const {id, type = "text", placeholder ="", required = false } = Astro.props;
---
<input
    id={id}
    type={type}
    placeholder={placeholder}
    required={required}
    class="input-field"
/>


<style>
  .input-field {
    width: 100%;
    padding: 0.6rem;
    margin: 0.4rem 0;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
  }

  .input-field:focus {
    border-color: #0077cc;
    outline: none;
    box-shadow: 0 0 4px rgba(0, 119, 204, 0.5);
  }
</style>