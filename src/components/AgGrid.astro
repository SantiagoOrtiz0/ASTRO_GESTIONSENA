---

const {data,headers} = Astro.props;
const lista  = btoa (JSON.stringify(data));
const cabecera = btoa (JSON.stringify(headers));

---

<div class="container">
<div class="ag-grid-instance" style="height: 500px; width: 100%;" data-datos={lista} data-cabecera={cabecera}>
    
</div>


<script>
    import {createGrid,ModuleRegistry, AllEnterpriseModule} from "ag-grid-enterprise";
    ModuleRegistry.registerModules([AllEnterpriseModule]);

    const gridElements = document.querySelectorAll('.ag-grid-instance');

    gridElements.forEach((gridElement) => {
      const el = gridElement as HTMLElement;

      if (el.dataset.gridInitialized === "true") return;
      el.dataset.gridInitialized = "true";

      const ListaDatosBase64 = el.dataset.datos ?? '';
      const Cabecera = el.dataset.cabecera ?? '';

      const cabeceraTabla = JSON.parse(atob(Cabecera));
      let gridApi;
      console.log(cabeceraTabla);

      const gridOptions = {
        statusBar:{
                        statusPanels:[{
                        statusPanel:'agSelectedRowCountComponent',
                        align:'left'
                        },
                        {
                            statusPanel: 'agFilteredRowCountComponent',
                            align:'left'
                        },
                        {
                            statusPanel: 'agTotalRowCountComponent',
                            align: 'center'
                        },
                        {
                            statusPanel: 'agAggregationComponent',
                            align: 'right'
                        }
                    ]
                 },

                defaultColDef: {
                        flex: 1,
                        filter: true,
                        floatingFilter:true,
                        enableRowGroup:true,
                        enableValue:true,
                    },

                  sideBar:{
                    toolPanels:[{
                        id: 'columns',
                        labelDefault: 'Columnas',
                        labelKey: 'columns',
                        iconKey: 'columns',
                        toolPanel: 'agColumnsToolPanel',
                    },
                    {
                        id: 'filters',
                        labelDefault: 'Filtros',
                        labelKey: 'filters',
                        iconKey: 'filters',
                        toolPanel: 'agFiltersToolPanel',
                    }
                    ],
                    defaultToolPanel: 'columns',
                 },

                 enableRangeSelection: true, 

                 rowData: JSON.parse(atob(ListaDatosBase64)),

                 columnDefs: [
                    ...cabeceraTabla.map((campo: string)=>({
                        field: campo,
                        headerName: campo.charAt(0).toUpperCase() + campo.slice(1),
                        sortable: true,
                        filter: true,
                        resizable: true,
                    }))
                 ],

                 pagination: true,
                 wrapText: true,
                 autoHeight: true,

                 onGridReady:(params:any)=>{
                    gridApi= params.api;
                 }
      }

      createGrid(el, gridOptions);
    });
</script>



</div>